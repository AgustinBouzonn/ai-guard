# Environment for the Go toolchain on a development machine.
# Persist per user with `go env -w NAME=value`, or export from your shell profile / CI job.

# Packages compiled (and test binaries run) in parallel. The default is one per logical core; every
# compile is a separate process, and linking a test binary is the memory peak of `go test`.
GOFLAGS=-p=4

# Build and test cache. Keep it on a local, fast filesystem: under WSL2 that means inside the Linux
# filesystem (the default, ~/.cache/go-build), never under /mnt/c.
# GOCACHE=/home/you/.cache/go-build

# Checks that produce no binary (what AI-Guard runs):
#   gofmt -l -e <files>        parse only: every syntax error, nothing written
#   go vet ./pkg/...           type-check + vet against cached export data: no object code, no link
# Heavy steps that belong to the remote tier:
#   go build ./...             compiles and LINKS every main package
#   go test ./...              links one test binary per package
# cgo projects only: external linking with a faster linker
#   go build -ldflags='-linkmode=external -extldflags=-fuse-ld=mold' ./...
